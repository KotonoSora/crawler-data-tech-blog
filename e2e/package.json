{
  "name": "@techblog/e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Playwright end-to-end suite for the tech-blog archive (spec 07 / BA 06).",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:stack": "E2E_STACK=1 playwright test --project=stack",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "5.9.3"
  }
}
