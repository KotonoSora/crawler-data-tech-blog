# Containerfile.web — build context is the repo root (see compose.yaml).
# Builds the microfrontend: shell (host, owns index.html + stylesheet) plus the three
# remotes; nginx serves the shell at / and each bundle under /mfe/<app>/ (spec 07).
# npm ci is the only install path once package-lock.json is committed (V-1).

FROM node:24 AS build
WORKDIR /src
COPY web/package.json web/package-lock.json* web/tsconfig.base.json ./
COPY web/packages/shared/package.json packages/shared/
COPY web/packages/ui/package.json packages/ui/
COPY web/apps/shell/package.json apps/shell/
COPY web/apps/catalog/package.json apps/catalog/
COPY web/apps/reader/package.json apps/reader/
COPY web/apps/admin/package.json apps/admin/
RUN if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi
COPY web/apps apps
COPY web/packages packages
COPY web/scripts scripts
RUN npm run build

FROM nginx:1.29 AS runtime
# NFR-20: serve the SPA as the unprivileged image user. The packaged nginx.conf writes its
# PID to /var/run, which that user cannot create; move it to /tmp and fail the build if the
# substitution did not match (the file aligns the directive with multiple spaces).
RUN sed -i 's|^[[:space:]]*pid[[:space:]].*;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf \
    && grep -q '^pid /tmp/nginx.pid;' /etc/nginx/nginx.conf
COPY deploy/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
RUN chown -R nginx:nginx /var/cache/nginx /usr/share/nginx/html \
    && chown nginx:nginx /var/log/nginx
USER nginx
EXPOSE 80
ENTRYPOINT ["nginx", "-g", "daemon off;"]
