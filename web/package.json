{
  "name": "tech-blog-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:shell": "npm run dev -w @techblog/shell",
    "dev:catalog": "npm run dev -w @techblog/catalog",
    "dev:reader": "npm run dev -w @techblog/reader",
    "dev:admin": "npm run dev -w @techblog/admin",
    "build": "npm run build -w @techblog/catalog && npm run build -w @techblog/reader && npm run build -w @techblog/admin && npm run build -w @techblog/shell",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
