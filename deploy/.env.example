# Copy to deploy/.env and fill in. NEVER commit .env (AGENTS.md working rules).

# Postgres superuser + migration role (Flyway runs with this)
POSTGRES_USER=techblog
POSTGRES_PASSWORD=change-me-superuser

# Application roles (created by deploy/init/01-init-databases.sh)
CRAWLER_DB_PASSWORD=change-me-crawler
API_DB_PASSWORD=change-me-api

# Crawler identity + politeness
CRAWLER_CONTACT=you@example.com
CRAWLER_ROLE=all
CRAWLER_GLOBAL_HOSTS=4
# Fixed politeness gap between two requests to the same host (ms). Medium-family hosts
# (medium.com, netflixtechblog.com, eng.lyft.com, engineering.grab.com) use the higher value.
CRAWLER_DEFAULT_DELAY_MS=2000
CRAWLER_MEDIUM_DELAY_MS=3000
CRAWLER_CONNECT_TIMEOUT_MS=10000
CRAWLER_READ_TIMEOUT_MS=30000
CRAWLER_FETCH_TOTAL_TIMEOUT_MS=60000
CRAWLER_MAX_ASSET_BYTES=52428800
CRAWLER_MAX_ARTICLE_BYTES=52428800

# Projection maintenance (full repair at boot + on demand; lag alerting every 30 s)
API_PROJECTION_LAG_CHECK_MS=30000
